.image-viewer {
  position: relative;
  width: 100%;
  background: #F0F0F0;
}

.swiper {
  width: 100%;
  height: 560rpx;
}

.slide-img {
  width: 100%;
  height: 100%;
}

.slide-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2C2C2C, #4A4A4A);
}

.slide-icon {
  font-size: 120rpx;
  margin-bottom: 12rpx;
  opacity: 0.7;
}

.slide-hint {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}

/* 图片计数器 */
.image-counter {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: var(--font-xs);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
}
