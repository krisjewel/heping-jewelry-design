/* ===== 分类页样式 ===== */

.page-category {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-light);
}

/* 顶部 */
.category-header {
  padding: 16rpx 0 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.ch-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.ch-count {
  font-size: var(--font-sm);
  color: var(--text-light);
}

/* 分类卡片网格 */
.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-card {
  width: calc((100% - 20rpx) / 2);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.category-card:active {
  transform: scale(0.97);
}

.cc-image-wrap {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cc-icon {
  font-size: 72rpx;
}

.cc-info {
  padding: 20rpx;
}

.cc-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.cc-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  display: block;
  margin-top: 6rpx;
}

.cc-count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--border);
}

.cc-count {
  font-size: var(--font-xs);
  font-weight: 600;
}

.cc-arrow {
  font-size: var(--font-sm);
  color: var(--gold-primary);
  font-weight: 600;
}

.bottom-space {
  height: 140rpx;
}
