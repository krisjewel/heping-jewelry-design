/* ===== 详情页样式 ===== */

.page-detail {
  min-height: 100vh;
  background: var(--bg-light);
}

.detail-body {
  padding: 24rpx;
}

/* 标题区 */
.detail-header {
  margin-bottom: 24rpx;
}

.dh-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.dh-name {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-primary);
}

.dh-tags {
  display: flex;
  gap: 8rpx;
}

.dh-tag {
  font-size: var(--font-xs);
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  font-weight: 600;
}

.dh-tag-new {
  background: var(--gold-primary);
  color: #FFFFFF;
}

.dh-tag-featured {
  background: var(--gold-light);
  color: var(--gold-dark);
}

.dh-category {
  font-size: var(--font-sm);
  font-weight: 500;
}

/* 核心参数 */
.detail-params {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.param-item {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  padding: 16rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.param-label {
  font-size: var(--font-xs);
  color: var(--text-light);
  display: block;
  margin-bottom: 6rpx;
}

.param-value {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

/* 价格 */
.detail-price {
  background: var(--gold-light);
  border-radius: var(--radius-md);
  padding: 24rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.dp-label {
  font-size: var(--font-sm);
  color: var(--gold-dark);
  display: block;
  margin-bottom: 8rpx;
}

.dp-value {
  font-size: var(--font-xl);
  font-weight: 700;
}

/* 详情区块 */
.detail-section {
  margin-bottom: 28rpx;
}

.ds-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--gold-primary);
}

.ds-content {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.9;
  display: block;
}

/* 规格表格 */
.spec-table {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.spec-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.spec-row:last-child {
  border-bottom: none;
}

.spec-key-fixed {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
  width: 140rpx;
}

.spec-val {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 500;
  text-align: right;
  flex: 1;
}

/* 底部操作栏 */
.detail-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: var(--radius-md);
  border: none;
  font-size: var(--font-md);
  font-weight: 600;
  padding: 0;
  margin: 0;
}

.bar-btn-share {
  background: transparent;
  color: var(--text-primary);
  border: 2rpx solid var(--border);
}

.bar-btn-contact {
  color: #FFFFFF;
  flex: 2;
}

.bar-btn-icon {
  font-size: var(--font-lg);
}

.bar-btn-text {
  letter-spacing: 2rpx;
}

.detail-bottom-space {
  height: 160rpx;
}

/* 加载状态 */
.detail-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--text-light);
  font-size: var(--font-md);
}
