/* ===== 列表页样式 ===== */

.page-list {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-light);
}

/* 顶部信息栏 */
.list-header {
  margin-bottom: 24rpx;
}

.lh-info {
  margin-bottom: 16rpx;
}

.lh-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.lh-count {
  font-size: var(--font-sm);
  color: var(--text-light);
  margin-top: 4rpx;
  display: block;
}

/* 排序按钮 */
.lh-sort {
  display: flex;
  gap: 12rpx;
}

.sort-btn {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: var(--bg-card);
  transition: all 0.2s;
}

.sort-btn.active {
  color: var(--gold-primary);
  background: var(--gold-light);
  font-weight: 600;
}

/* 二级分类（宝石材质） */
.gem-filter {
  margin-bottom: 24rpx;
}

.gem-scroll {
  white-space: nowrap;
}

.gem-tabs {
  display: inline-flex;
  gap: 12rpx;
}

.gem-tab {
  display: inline-block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: var(--bg-card);
  border: 2rpx solid transparent;
  transition: all 0.2s;
  white-space: nowrap;
}

.gem-tab.active {
  color: var(--gold-primary);
  background: var(--gold-light);
  border-color: var(--gold-primary);
  font-weight: 600;
}

/* 作品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.product-grid-item {
  width: calc((100% - 20rpx) / 2);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-light);
}

.bottom-space {
  height: 140rpx;
}
