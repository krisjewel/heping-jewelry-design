/* ===== 首页样式 ===== */

/* 顶部Banner */
.hero-banner {
  width: 100%;
  height: 480rpx;
  position: relative;
  overflow: hidden;
}

.hero-dark {
  background: linear-gradient(180deg, #1A1A1A 0%, #0D0D0D 100%);
}

.hero-overlay {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.15);
}

.hero-content {
  text-align: center;
  color: #FFFFFF;
  z-index: 1;
}

.hero-brand {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  display: block;
  color: var(--gold-primary);
}

.hero-slogan {
  font-size: var(--font-lg);
  display: block;
  margin-top: 12rpx;
  letter-spacing: 6rpx;
  color: var(--gold-primary);
  opacity: 0.85;
}

.hero-divider {
  width: 60rpx;
  height: 2rpx;
  background: var(--gold-primary);
  margin: 20rpx auto;
}

.hero-subtitle {
  font-size: var(--font-xs);
  letter-spacing: 6rpx;
  color: var(--gold-primary);
  opacity: 0.6;
}

.hero-wave {
  position: absolute;
  bottom: -2rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: var(--bg-light);
  border-radius: 50% 50% 0 0;
}

/* 搜索入口 */
.search-section {
  padding-top: 0;
}

.search-entry {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: var(--bg-card);
  border-radius: 36rpx;
  padding: 0 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}

.search-entry:active {
  border-color: var(--gold-primary);
  background: #FDFCF8;
}

.search-entry-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.search-entry-text {
  font-size: var(--font-sm);
  color: var(--text-light);
}

/* 通用区块 */
.section {
  padding: 32rpx 24rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.section-badge {
  font-size: 18rpx;
  color: var(--gold-primary);
  border: 1rpx solid var(--gold-primary);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  letter-spacing: 2rpx;
}

.section-subtitle {
  font-size: var(--font-sm);
  color: var(--text-light);
  display: block;
  margin-top: 6rpx;
}

/* 精选作品横向滚动 */
.featured-scroll {
  width: 100%;
  white-space: nowrap;
}

.featured-list {
  display: inline-flex;
  gap: 20rpx;
  padding-right: 24rpx;
}

.featured-item {
  width: 280rpx;
  display: inline-block;
  white-space: normal;
  cursor: pointer;
}

.featured-item:active {
  opacity: 0.85;
}

.featured-image {
  width: 280rpx;
  height: 280rpx;
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
  background: #F0F0F0;
}

.featured-img {
  width: 100%;
  height: 100%;
}

.featured-tag-new {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: var(--gold-primary);
  color: #FFFFFF;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  font-weight: 600;
}

.featured-info {
  padding: 16rpx 4rpx;
}

.featured-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.featured-meta {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

.featured-price {
  font-size: var(--font-sm);
  font-weight: 700;
  display: block;
  margin-top: 8rpx;
}

/* 品牌简介卡片 */
.about-card {
  padding: 32rpx;
}

.about-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.about-icon {
  font-size: 36rpx;
}

.about-title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.about-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.8;
  display: block;
}

.about-features {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}

.about-feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.af-icon {
  font-size: 36rpx;
}

.af-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

/* 底部留白 */
.bottom-space {
  height: 140rpx;
}
