/* ========================================
   何平珠宝设计 — 全局样式系统
   轻奢金色调 · 优雅简约
   ======================================== */

page {
  --gold-primary: #C9A96E;
  --gold-dark: #8B6914;
  --gold-light: #F5E6CC;
  --gold-gradient: linear-gradient(135deg, #C9A96E 0%, #E0C87C 50%, #B8942E 100%);
  --bg-dark: #1A1A1A;
  --bg-light: #FAFAFA;
  --bg-card: #FFFFFF;
  --text-primary: #2C2C2C;
  --text-secondary: #6B6B6B;
  --text-light: #999999;
  --text-white: #FFFFFF;
  --border: #E8E8E8;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  font-size: var(--font-md);
  color: var(--text-primary);
  background-color: var(--bg-light);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 通用工具类 */
.gold-text {
  color: var(--gold-primary);
}

.gold-bg {
  background: var(--gold-gradient);
}

.gold-bg-light {
  background: var(--gold-light);
}

.dark-bg {
  background: var(--bg-dark);
}

.white-bg {
  background: var(--bg-card);
}

.text-center {
  text-align: center;
}

.text-secondary {
  color: var(--text-secondary);
}

.text-light {
  color: var(--text-light);
}

/* 通用按钮 */
.btn-gold {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--gold-gradient);
  color: #FFFFFF;
  font-size: var(--font-md);
  font-weight: 600;
  border-radius: var(--radius-md);
  border: none;
  padding: 0 48rpx;
  letter-spacing: 2rpx;
}

.btn-gold:active {
  opacity: 0.85;
}

.btn-outline-gold {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: transparent;
  color: var(--gold-primary);
  font-size: var(--font-md);
  font-weight: 600;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--gold-primary);
  padding: 0 48rpx;
  letter-spacing: 2rpx;
}

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 安全区域底部留白 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
